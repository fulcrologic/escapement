;; Escapement project config — TEMPLATE.
;;
;; Copy to `.escapement.edn` (which is gitignored) and edit. Escapement reads it
;; at startup; nothing here needs to be `source`d into your shell.
;;
;;   cp .escapement.edn.example .escapement.edn
;;
;; ── Credentials ────────────────────────────────────────────────────────────
;; Escapement builds its LLM backend from `:llm/credentials` (used when you pass
;; no `--backend` flag). Each entry names a `:provider` and supplies an API key.
;; Prefer keeping keys OUT of this file: declare external JSON stores in
;; `:llm/credential-sources` and pull each key with `:key-from [<source> <path…>]`.
;; You may instead inline `:api-key "sk-…"` (discouraged — then keep the file
;; gitignored). `:codex` (ChatGPT subscription) needs neither: it uses the OAuth
;; file at ~/.escapement/openai-auth.json (run `escapement login codex`).
;;
;; Supported `:provider` keywords (see escapement.llm.providers/provider-templates):
;;   :anthropic :openai :openrouter :z-ai :z-ai-plan :ollama :opencode-go
;;   :opencode-go-anthropic :codex
;;
;; ── Models ─────────────────────────────────────────────────────────────────
;; Charts select models by ALIAS KEYWORD, never a raw string. `:llm/aliases`
;; maps each alias to one or more `{:provider :model}` targets (tried in order).
;; `:llm/preferences` is the ordered fallback when a chart names no `:model`.

{:llm/credential-sources
 ;; <source-kw> -> path to a JSON file holding your keys ( ~ is expanded ).
 {:opencode "~/.local/share/opencode/auth.json"}

 :llm/credentials
 ;; Ordered provider descriptors. `:key-from [<source> <json path…>]` reads the
 ;; key from a store above; the path indexes into the parsed JSON.
 [{:provider :anthropic   :api-key "sk-ant-…"}                       ; inline (discouraged)
  {:provider :z-ai-plan   :key-from [:opencode "zai-coding-plan" "key"]}
  {:provider :ollama      :key-from [:opencode "ollama-cloud" "key"]}
  {:provider :opencode-go :key-from [:opencode "opencode-go" "key"]}
  {:provider :codex}]                                                ; OAuth file; no key

 :llm/aliases
 {:default-sonnet [{:provider :anthropic :model "claude-sonnet-4-7"}]
  :fast-glm       [{:provider :z-ai-plan :model "glm-4.7"}]
  :gpt            [{:provider :codex     :model "gpt-5.5"}]}

 ;; Ordered fallback for any conversation that names no model.
 :llm/preferences [:default-sonnet]}
