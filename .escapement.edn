;; Local-development LLM config for Escapement.
;;
;; Escapement resolves a conversation's model through ALIAS KEYWORDS, not the
;; raw `--model` string (that flag only sets the backend's default-model). When
;; a chart names no `:model`, resolution falls back to `:llm/preferences`. With
;; no config that default is the built-in glm/claude alias set — which 404s
;; against a local ollama server and then fails over through every other model
;; (this is why the haiku tournament "took forever" before).
;;
;; This file pins local-first resolution so `bb haiku` (and any other CLI run in
;; this repo that names no model) uses the fast local `gemma3:1b` via ollama.
;; The default cloud aliases are kept too, so a chart that explicitly asks for
;; e.g. `:model :default-sonnet` still resolves.
{:llm/aliases
 {:local          [{:provider :ollama    :model "gemma3:1b"}]
  :default-glm    [{:provider :z-ai-plan :model "glm-5.1"}
                   {:provider :z-ai      :model "glm-4.7"}]
  :default-sonnet [{:provider :anthropic :model "claude-sonnet-4-7"}]
  :default-opus   [{:provider :anthropic :model "claude-opus-4-7"}]
  :default-gpt    [{:provider :openai    :model "gpt-5"}]}

 ;; Ordered fallback for any conversation that names no model. Local first.
 :llm/preferences [:local]}
